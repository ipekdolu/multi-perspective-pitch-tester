ANTHROPIC_API_KEY=

# Optional: override the model personas/rebuttals use (default: claude-opus-5)
PITCH_TESTER_MODEL=claude-opus-5

# The standalone MCP server (mcp_server/) must be running separately for
# persona_reaction / challenge_and_rebuttal to work — see mcp_server/server.py
MCP_SERVER_URL=http://127.0.0.1:8765/sse

# Langfuse (optional): tracing + online sampled scoring in app/api.py,
# and the offline golden-dataset experiment in app/eval/. If unset, the
# app runs fine with tracing/scoring silently disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Fraction of live API runs that get sampled for online judge scoring
LANGFUSE_ONLINE_SAMPLE_RATE=0.2
